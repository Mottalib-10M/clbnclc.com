---
/** Embeddable tool (iframe): no navigation, noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import Tool from '../../components/Tool.astro';
import LicenceNotice from '../../components/LicenceNotice.astro';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Language test score to CLB and CRS points (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}${route('home', 'en')}`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <p class="mb-2 text-xs text-navy-600">Independent site, not IRCC or the Government of Canada, not a test body.</p>
    <Tool tool={{ kind: 'converter', props: { focus: 'all' } }} lang="en" primary={true} seedKey="embed-en" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}${route('home', 'en')}`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a></p>
    <LicenceNotice lang="en" class="mt-2 text-center text-[11px] text-navy-600" />
  </body>
</html>
