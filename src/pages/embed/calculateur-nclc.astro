---
/** Embeddable tool (iframe): no navigation, noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import Tool from '../../components/Tool.astro';
import LicenceNotice from '../../components/LicenceNotice.astro';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
---
<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Score de test de langue en NCLC et en points (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}${route('home', 'fr')}`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <p class="mb-2 text-xs text-navy-600">Site indépendant : ni IRCC, ni le gouvernement du Canada, ni un organisme de test.</p>
    <Tool tool={{ kind: 'converter', props: { focus: 'all' } }} lang="fr" primary={true} seedKey="embed-fr" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}${route('home', 'fr')}`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.fr}</a></p>
    <LicenceNotice lang="fr" class="mt-2 text-center text-[11px] text-navy-600" />
  </body>
</html>
